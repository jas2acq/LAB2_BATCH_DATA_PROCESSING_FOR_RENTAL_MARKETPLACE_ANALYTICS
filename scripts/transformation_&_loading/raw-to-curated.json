			"code": "from pyspark.sql.functions import lower, trim, to_date, col, concat_ws, year, lpad, weekofyear, month\nfrom pyspark.sql.types import BooleanType, LongType\n\ndf_user_viewing = dfc.select(list(dfc.keys())[0]).toDF()\n\n# Cast IDs to BIGINT\ndf_user_viewing = df_user_viewing.withColumn('user_id', col('user_id').cast(LongType()))\ndf_user_viewing = df_user_viewing.withColumn('apartment_id', col('apartment_id').cast(LongType()))\n\n# Convert viewed_at to DATE\ndf_user_viewing = df_user_viewing.withColumn('viewed_at', to_date(col('viewed_at'), 'dd/MM/yyyy'))\n\n# Cast is_wishlisted to boolean\ndf_user_viewing = df_user_viewing.withColumn('is_wishlisted', col('is_wishlisted').cast(BooleanType()))\n\n# Clean call_to_action\ndf_user_viewing = df_user_viewing.withColumn('call_to_action', lower(trim(col('call_to_action'))))\n\n# Add week_year (e.g., '2025-25') and month_year (e.g., '2025-06')\ndf_user_viewing = df_user_viewing.withColumn('week_year', concat_ws('-', year('viewed_at'), lpad(weekofyear('viewed_at'), 2, '0')))\ndf_user_viewing = df_user_viewing.withColumn('month_year', concat_ws('-', year('viewed_at'), lpad(month('viewed_at'), 2, '0')))\n\n# Deduplicate on primary key\ndf_user_viewing = df_user_viewing.dropDuplicates(['user_id', 'apartment_id', 'viewed_at'])\n\ndyf_user_viewing_transformed = DynamicFrame.fromDF(df_user_viewing, glueContext, \"dyf_user_viewing_transformed\")\n\nreturn DynamicFrameCollection({\"user_viewing_transformed\": dyf_user_viewing_transformed}, glueContext)\n",
