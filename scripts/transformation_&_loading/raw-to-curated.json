			"code": "from pyspark.sql.functions import lower, trim, col\nfrom pyspark.sql.types import LongType, FloatType, IntegerType, BooleanType\n\ndf_apartment_attributes = dfc.select(list(dfc.keys())[0]).toDF()\n\n# Cast columns to correct types\ndf_apartment_attributes = df_apartment_attributes.withColumn('id', col('id').cast(LongType()))\ndf_apartment_attributes = df_apartment_attributes.withColumn('bathrooms', col('bathrooms').cast(FloatType()))\ndf_apartment_attributes = df_apartment_attributes.withColumn('bedrooms', col('bedrooms').cast(IntegerType()))\ndf_apartment_attributes = df_apartment_attributes.withColumn('fee', col('fee').cast(FloatType()))\ndf_apartment_attributes = df_apartment_attributes.withColumn('has_photo', col('has_photo').cast(BooleanType()))\ndf_apartment_attributes = df_apartment_attributes.withColumn('pets_allowed', col('pets_allowed').cast(BooleanType()))\ndf_apartment_attributes = df_apartment_attributes.withColumn('square_feet', col('square_feet').cast(IntegerType()))\ndf_apartment_attributes = df_apartment_attributes.withColumn('latitude', col('latitude').cast(FloatType()))\ndf_apartment_attributes = df_apartment_attributes.withColumn('longitude', col('longitude').cast(FloatType()))\n\n# Clean string columns\nfor str_col in ['category', 'body', 'amenities', 'price_display', 'price_type', 'address', 'cityname', 'state']:\n    df_apartment_attributes = df_apartment_attributes.withColumn(str_col, lower(trim(col(str_col))))\n\n# Deduplicate on id\ndf_apartment_attributes = df_apartment_attributes.dropDuplicates(['id'])\n\ndyf_apartment_attributes_transformed = DynamicFrame.fromDF(df_apartment_attributes, glueContext, \"dyf_apartment_attributes_transformed\")\n\nreturn DynamicFrameCollection({\"apartment_attributes_transformed\": dyf_apartment_attributes_transformed}, glueContext)",
