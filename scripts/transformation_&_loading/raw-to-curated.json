			"name": "Custom Transform-bookings",
			"generatedNodeName": "CustomTransformbookings_node1750403528597",
			"classification": "Transform",
			"type": "CustomCode",
			"code": "from pyspark.sql.functions import lower, trim, to_date, col, datediff, when, concat_ws, year, lpad, weekofyear, month\nfrom pyspark.sql.types import LongType, DoubleType, IntegerType\n\ndf_bookings = dfc.select(list(dfc.keys())[0]).toDF()\n\n# Cast columns to correct types\ndf_bookings = df_bookings.withColumn('booking_id', col('booking_id').cast(LongType()))\ndf_bookings = df_bookings.withColumn('user_id', col('user_id').cast(LongType()))\ndf_bookings = df_bookings.withColumn('apartment_id', col('apartment_id').cast(LongType()))\ndf_bookings = df_bookings.withColumn('booking_date', to_date(col('booking_date'), 'dd/MM/yyyy'))\ndf_bookings = df_bookings.withColumn('checkin_date', to_date(col('checkin_date'), 'dd/MM/yyyy'))\ndf_bookings = df_bookings.withColumn('checkout_date', to_date(col('checkout_date'), 'dd/MM/yyyy'))\ndf_bookings = df_bookings.withColumn('total_price', col('total_price').cast(DoubleType()))\n\n# Clean string columns\nfor str_col in ['currency', 'booking_status']:\n    df_bookings = df_bookings.withColumn(str_col, lower(trim(col(str_col))))\n\n# Calculate booking_duration_days\ndf_bookings = df_bookings.withColumn('booking_duration_days', datediff(col('checkout_date'), col('checkin_date')))\n\n# Calculate confirmed_revenue\ndf_bookings = df_bookings.withColumn('confirmed_revenue', when(col('booking_status') == 'confirmed', col('total_price')).otherwise(None).cast(DoubleType()))\n\n# Add week_year and month_year\ndf_bookings = df_bookings.withColumn('week_year', concat_ws('-', year('booking_date'), lpad(weekofyear('booking_date'), 2, '0')))\ndf_bookings = df_bookings.withColumn('month_year', concat_ws('-', year('booking_date'), lpad(month('booking_date'), 2, '0')))\n\n# Deduplicate on booking_id\ndf_bookings = df_bookings.dropDuplicates(['booking_id'])\n\ndyf_bookings_transformed = DynamicFrame.fromDF(df_bookings, glueContext, \"dyf_bookings_transformed\")\n\nreturn DynamicFrameCollection({\"bookings_transformed\": dyf_bookings_transformed}, glueContext)\n",
